+        // The DOS save is authoritative for currently active quests.
+        // A sidecar can retain completed history, but never invent a
+        // presently accepted/successful quest absent from the DOS record.
+        for(int i=1;i<=8;++i){
+            const auto v=p.kingQuest[i];
+            if(v==0){
+                if(state[i]==1 || state[i]==2) state[i]=0;
+            }else{
+                if(state[i]==0)order.push_back(i);
+                state[i]=(v==1?2:1);
+            }
+        }
+        order.erase(std::remove_if(order.begin(),order.end(),
+            [&](int id){return state[id]==0;}),order.end());
         previous=p.kingQuest;
+    }
+    void resetForNewCharacter(const std::string& save,const PlayerSave& p){
+        // Reusing a slot must not inherit the previous character's history.
+        path=save;
+        order.clear();state.fill(0);previous=p.kingQuest;
+        std::remove((save+".krquests").c_str());
+    }
+    bool persist() const {
+        if(path.empty())return false;
+        std::ofstream out(path+".krquests",std::ios::trunc);
+        if(!out)return false;
+        for(int id:order) if(state[id]!=0)out<<id<<" "<<state[id]<<"\n";
+        out.flush();
+        return static_cast<bool>(out);
     }
